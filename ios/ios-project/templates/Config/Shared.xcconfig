// Shared.xcconfig
// Minimal shared configuration — all other settings use Xcode project defaults.
// This file is the single place for project identity; AI agents edit this
// instead of the pbxproj.

// ==========================================
// Project Identity
// ==========================================
DEVELOPMENT_TEAM = __TEAM_ID__

PRODUCT_NAME = APPNAME
PRODUCT_DISPLAY_NAME = __DISPLAY_NAME__
PRODUCT_BUNDLE_IDENTIFIER = __BUNDLE_ID__
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1

// ==========================================
// Swift Language Mode & Concurrency
// ==========================================
// Swift 6 strict concurrency from day one — a new project adopts it for free;
// retrofitting later is the painful part. Do not lower these.
SWIFT_VERSION = 6.0
SWIFT_APPROACHABLE_CONCURRENCY = YES
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor

// ==========================================
// Platform Configuration
// ==========================================
IPHONEOS_DEPLOYMENT_TARGET = __DEPLOYMENT_TARGET__

// (1 == iPhone, 2 == iPad)
TARGETED_DEVICE_FAMILY = __DEVICE_FAMILY__

// ==========================================
// Info PLIST
// ==========================================
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations = UIInterfaceOrientationLandscapeRight UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationPortrait
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad = UIInterfaceOrientationLandscapeRight UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown

// Capability-specific usage descriptions and framework links go here.
// Example (HealthKit):
//   INFOPLIST_KEY_NSHealthShareUsageDescription = <why the app reads Health data>
//   INFOPLIST_KEY_NSHealthUpdateUsageDescription = <why the app writes Health data>
//   OTHER_LDFLAGS = $(inherited) -framework HealthKit

// ==========================================
// Entitlements
// ==========================================
// AI agents can modify Config/APPNAME.entitlements to add capabilities
CODE_SIGN_ENTITLEMENTS = Config/APPNAME.entitlements
